#!/bin/bash

# Read commit message file
commit_msg_file="$1"
commit_msg=$(head -n1 "$commit_msg_file")

# Define regex for commit message
regex="^(feat|fix|docs|style|refactor|test|chore|build|ci|perf|revert)\([a-zA-Z0-9_-]+\): .+"

if [[ ! $commit_msg =~ $regex ]]; then
  echo "❌ Commit message does not follow the format:"
  echo "   <type>(<scope>): short description"
  echo ""
  echo "   Example: feat(auth): add login endpoint"
  echo ""
  echo "Allowed types: feat, fix, docs, style, refactor, test, chore, build, ci, perf, revert"
  exit 1
fi

exit 0
